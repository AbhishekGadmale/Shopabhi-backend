## Backend environment variables (Shopabhi-backend)
#
# Create a local file named ".env" in this same folder and fill values.
# Never commit the real ".env" (keep secrets private).
#
# Required
MONGO_URI=mongodb+srv://shopabhi:BQ3qGCLZjNupW6ck@cluster0.dqjjz8f.mongodb.net/Shop_Abhi?retryWrites=true&w=majority&appName=Cluster0
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
#
# Optional
NODE_ENV=development
PORT=5000
ALLOWED_ORIGINS=http://localhost:3000,https://shopabhi.onrender.com/
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# Razorpay
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

